<% @page_title = "Work" %>
<% @body_class = "sidebar work-workspace" %>

<% content_for :head do %>
  <%= turbo_exempts_page_from_cache %>
<% end %>

<% content_for :nav do %>
  <div class="room-header__identity room--current min-width">
    <span class="room-header__kind">Workspace</span>
    <h1 class="room__contents overflow-ellipsis">
      <span class="room-header__name overflow-ellipsis">Work</span>
    </h1>
  </div>
<% end %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<section class="work-threads" aria-labelledby="work-threads-title">
  <header class="work-threads__header">
    <div>
      <span class="work-threads__eyebrow">Workspace work</span>
      <h1 id="work-threads-title">Work threads</h1>
      <p>A work thread is a channel thread with a status and an owner. This list gathers tracked work from every channel you belong to, so you can pick it back up without searching through archived threads.</p>
    </div>

    <nav class="work-threads__filters" aria-label="Work thread filters">
      <%= link_to "Open work", work_threads_path(state: "open"), class: [ "btn", "work-threads__filter", "active": @state == "open" ] %>
      <%= link_to "Completed", work_threads_path(state: "done"), class: [ "btn", "work-threads__filter", "active": @state == "done" ] %>
      <%= link_to "All work", work_threads_path(state: "all"), class: [ "btn", "work-threads__filter", "active": @state == "all" ] %>
    </nav>
  </header>

  <details class="work-threads__guide" <%= "open" if @threads.empty? %>>
    <summary>How to start a work thread</summary>
    <ol>
      <li>Open a channel and choose <strong>Threads</strong> in the channel header.</li>
      <li>Open an existing thread, or choose <strong>New thread</strong> to start one from scratch or from a message.</li>
      <li>In the thread, open <strong>Manage</strong> and choose <strong>Track as work</strong>. The thread starts as <strong>Planned</strong>.</li>
      <li>Use <strong>Update work</strong> to assign an owner from the channel and move it through <strong>In progress</strong>, <strong>Blocked</strong>, and <strong>Done</strong>.</li>
    </ol>
    <p>The person who started the thread, the channel's creator, or an administrator can turn tracking on and assign an owner. The assigned owner can update the status. Completing work keeps the conversation and its history.</p>
  </details>

  <% if @threads.empty? %>
    <p class="work-threads__empty">
      <% case @state %>
      <% when "done" %>
        No completed work yet. Work shows up here once its status is set to Done.
      <% when "all" %>
        No work threads yet. Track a channel thread as work and it will appear here.
      <% else %>
        No open work yet. Track a channel thread as work and it will appear here.
      <% end %>
    </p>
  <% else %>
    <div class="work-threads__list" role="list">
      <%= render partial: "work_threads/thread", collection: @threads, as: :thread %>
    </div>
  <% end %>
</section>
