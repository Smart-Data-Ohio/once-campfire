<% boosts = message.boosts.ordered.to_a %>
<% reaction_boosts = boosts.group_by(&:content) %>
<% legacy_boosts = boosts.reject { |boost| EmojiHelper::REACTIONS.key?(boost.content) } %>

<div id="<%= dom_id(message, :boosts) %>" class="flex-inline flex-wrap gap" data-turbo-streaming-target="container">
  <% if reaction_boosts.any? { |character, _| EmojiHelper::REACTIONS.key?(character) } %>
    <div class="boosts__reactions flex-inline flex-wrap gap" role="group" aria-label="Message reactions">
      <% EmojiHelper::REACTIONS.each do |character, title| %>
        <% next unless reaction_boosts.key?(character) %>
        <%= render "messages/boosts/reaction", message:, character:, title:, boosts: reaction_boosts.fetch(character) %>
      <% end %>
    </div>
  <% end %>

  <% if legacy_boosts.any? %>
    <div class="boosts__legacy flex-inline flex-wrap gap">
      <%= render partial: "messages/boosts/boost", collection: legacy_boosts, as: :boost %>
    </div>
  <% end %>
</div>
