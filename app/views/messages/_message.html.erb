<%# Be sure to check/update messages/_template.html.erb when changing this file %>

<%= message_tag message do %>
  <h2 class="message__day-separator"><%= local_datetime_tag message.created_at, style: :date %></h2>

    <figure class="avatar message__avatar">
      <%= avatar_tag message.creator %>
    </figure>

    <turbo-frame id="<%= dom_id(message, :edit) %>">
      <div class="message__body">
        <div class="message__body-content">
          <div class="message__meta">
            <h3 class="message__heading">
              <span class="message__author" title="<%= message.creator.title %>">
                <strong data-reply-target="author"><%= message.creator.name %></strong>
              </span>
              <%= link_to message_timestamp(message, class: "message__timestamp"), message_link_url(message), target: "_top",
                    class: "message__permalink" %>
              <% room_icon = local_assigns[:show_room_icon] ? icon_avatar_tag(message.room.icon_name, size: 16) : nil %>
              <span class="message__room<%= " message__room--custom" if room_icon %>">
                <%= room_icon %><%= link_to room_display_name(message.room, for_user: nil), message_link_url(message), target: "_top", data: { reply_target: "link" } %>
              </span>
            </h3>
            <%= render "messages/actions", message: message, url: message_link_url(message) %>
          </div>
          <%= render "messages/context", message: message %>
          <%= render "messages/presentation", message: message %>
          <%= render "messages/drive_attachments", message: message %>
          <%= render "github/pull_requests/cards", message: message %>
          <%= render "twitter/posts/cards", message: message %>
          <%= render "rooms/events/cards", message: message %>
          <%= render "messages/boosts/boosts", message: message %>
        </div>
      </div>
    </turbo-frame>
  <% end %>
