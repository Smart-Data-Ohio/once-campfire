<% @page_title = "Agent credentials" %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to edit_account_bot_path(@bot) %>
  </div>
<% end %>

<section class="panel panel--wide txt-align-center flex flex-column gap">
  <div class="pad-inline-double center">
    <h1 class="margin-none">Credentials for <%= @bot.name %></h1>
    <p class="margin-none-block-start">Bearer tokens for API access. The secret is shown once at creation.</p>
  </div>

  <div class="pad-inline pad-block-start txt-align-start">
    <h2 class="txt-large margin-none">New credential</h2>

    <%= form_with model: @credential, url: account_bot_credentials_path(@bot), class: "flex flex-column gap margin-block-start" do |form| %>
      <% if @credential.errors.any? %>
        <div class="txt-small" style="color: var(--color-negative)">
          <%= @credential.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div class="flex align-center gap">
        <label class="flex align-center gap flex-item-grow txt-large input input--actor">
          <%= form.text_field :name, class: "input", placeholder: "Credential name", required: true, autocomplete: "off" %>
        </label>
      </div>

      <div class="flex align-center gap">
        <label class="flex align-center gap flex-item-grow txt-large input input--actor">
          <%= form.datetime_local_field :expires_at, class: "input" %>
        </label>
        <span class="txt-small">Optional expiry</span>
      </div>

      <div>
        <%= form.submit "Create credential", class: "btn btn--reversed" %>
      </div>
    <% end %>
  </div>

  <div class="pad-inline pad-block-start">
    <menu class="flex flex-column gap margin-none pad txt-align-start">
      <% if @credentials.any? %>
        <%= render partial: "accounts/bots/credentials/credential", collection: @credentials, as: :credential %>
      <% else %>
        <li class="txt-small">No credentials yet.</li>
      <% end %>
    </menu>
  </div>
</section>
