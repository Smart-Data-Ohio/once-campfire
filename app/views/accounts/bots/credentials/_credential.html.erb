<li class="flex flex-column gap flush fill-shade border-radius pad-block pad-inline-double">
  <div class="flex align-center gap">
    <div class="min-width flex-item-grow">
      <div class="overflow-ellipsis txt-large"><strong><%= credential.name %></strong></div>
      <div class="overflow-ellipsis txt-small">
        •••• <%= credential.token_last_four %>
        · created by <%= credential.created_by.name %>
        · <%= credential.created_at.to_fs(:short) %>
        <% if credential.last_used_at.present? %>
          · last used <%= time_ago_in_words(credential.last_used_at) %> ago
        <% else %>
          · never used
        <% end %>
        <% if credential.expires_at.present? %>
          · expires <%= credential.expires_at.to_fs(:short) %>
        <% end %>
      </div>
    </div>

    <% if credential.revoked? %>
      <span class="txt-small">Revoked</span>
    <% elsif credential.expired? %>
      <span class="txt-small">Expired</span>
    <% else %>
      <%= button_to account_bot_credential_path(credential.agent.user, credential), method: :delete, class: "btn txt--small btn--negative",
            data: { turbo_confirm: "Revoke #{credential.name}? This takes effect immediately." } do %>
        Revoke
      <% end %>
    <% end %>
  </div>
</li>
