<% @page_title = "Credential created" %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to account_bot_credentials_path(@bot) %>
  </div>
<% end %>

<section class="panel txt-align-center flex flex-column gap">
  <div class="pad-inline-double center">
    <h1 class="margin-none">Copy this secret now</h1>
    <p class="margin-none-block-start">It will not be shown again.</p>
  </div>

  <div class="pad-inline pad-block-start">
    <div class="flex align-center gap">
      <div class="flex-item-grow">
        <input type="text" class="input full-width fill-white" value="<%= @plain_secret %>" aria-label="New credential secret" readonly>
      </div>

      <div class="txt-small">
        <%= button_to_copy_to_clipboard(@plain_secret) do %>
          <%= image_tag "copy-paste.svg", aria: { hidden: "true" }, size: 20 %>
          <span class="for-screen-reader">Copy credential secret</span>
        <% end %>
      </div>
    </div>

    <p class="txt-small">Use as <code>Authorization: Bearer &lt;secret&gt;</code> for <code>GET /agents/me</code>.</p>

    <%= link_to "Done", account_bot_credentials_path(@bot), class: "btn btn--reversed" %>
  </div>
</section>
