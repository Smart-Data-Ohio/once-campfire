<% content_for :footer do %>
  <div class="composer position-relative"
      data-controller="typing-notifications" data-typing-notifications-active-class="typing-indicator--active">
    <turbo-frame id="composer-frame" class="composer__frame min-width">
      <%= composer_form_tag(room) do |form| %>
        <fieldset data-composer-target="fields" contents>
          <div class="composer__stack">
            <div class="composer__filelist flex flex--align-center gap flex-wrap" data-composer-target="fileList"></div>

            <div class="composer__surface flex align-end gap">
              <label class="composer__attachment-btn btn btn--borderless flex-item-no-shrink input--file" title="Attach a file">
                <span class="composer__attachment-mark" aria-hidden="true">+</span>
                <input type="file" data-action="composer#filePicked" multiple />
                <span class="for-screen-reader">Attach a file</span>
              </label>

              <div class="composer__editor min-width flex-item-grow" data-controller="markdown-editor">
                <%= form.text_area :markdown_source,
                      rows: 1,
                      maxlength: 50_000,
                      class: "composer__textarea input",
                      placeholder: "Message ##{room_display_name(room)}",
                      aria: { multiline: "true", label: "Write a message" },
                      data: {
                        controller: "markdown-autocomplete",
                        action: "input->markdown-editor#resize input->markdown-autocomplete#search input->typing-notifications#start focus->markdown-autocomplete#focus blur->markdown-autocomplete#blur keydown->markdown-editor#shortcut keydown->composer#submitByKeyboard",
                        markdown_autocomplete_url_value: autocompletable_users_path(room_id: room.id),
                        markdown_editor_target: "source",
                        composer_target: "markdown",
                        suggestion_results_placement: "above" } %>
              </div>

              <%= form.button name: "send", type: "submit", data: { action: "composer#submit" },
                    class: "composer__send btn btn--reversed flex-item-no-shrink" do %>
                <%= image_tag "arrow-up.svg", size: 17, aria: { hidden: "true" } %>
                <span class="for-screen-reader">Send Message</span>
              <% end %>
            </div>
          </div>
        </fieldset>

        <div class="typing-indicator gap txt-small align-center flex-inline" data-typing-notifications-target="indicator">
          <div class="typing-indicator__author spinner" data-typing-notifications-target="author"></div>
        </div>

        <%= form.hidden_field :client_message_id, data: { composer_target: "clientid" } %>
      <% end %>
    </turbo-frame>
  </div>
<% end %>
