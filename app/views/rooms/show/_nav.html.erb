<% content_for :nav do %>
  <div class="room-header__identity room--current min-width">
    <span class="room-header__kind"><%= room.direct? ? "Direct message" : "Channel" %></span>
    <h1 class="room__contents overflow-ellipsis">
      <% if room.direct? %>
        <span class="for-screen-reader">Ping with</span>
      <% else %>
        <span class="room-header__hash" aria-hidden="true">#</span>
      <% end %>

      <span class="room-header__name overflow-ellipsis"><%= room_display_name(room) %></span>
    </h1>
  </div>

  <div class="room-header__actions">
    <%= link_to searches_path, class: "btn room-header__action", aria: { label: "Search messages" }, title: "Search messages" do %>
      <%= image_tag "search.svg", size: 20, aria: { hidden: "true" } %>
      <span class="room-header__action-label">Search</span>
    <% end %>

    <% if !room.direct? && Huddle.configured? %>
      <%= tag.button type: "button", class: "btn huddle-launcher room-header__action", aria: { pressed: "false", label: "Join huddle" },
            data: {
              controller: "huddle-launcher",
              action: "huddle-launcher#join",
              huddle_launcher_room_id_value: room.id,
              huddle_launcher_room_name_value: room_display_name(room)
            } do %>
        <%= image_tag "headphones.svg", size: 20, aria: { hidden: "true" } %>
        <span data-huddle-launcher-target="label">Join huddle</span>
      <% end %>
    <% end %>

    <%= link_to_edit_room(room) do %>
      <%= image_tag "settings.svg", size: 20, aria: { hidden: "true" } %>
      <span class="for-screen-reader">Settings for this <%= room.direct? ? "Ping" : "room" %></span>
    <% end %>

    <%= render "rooms/involvements/bell", room: room %>
  </div>
<% end %>
