<article class="room-events__item" role="listitem" aria-labelledby="<%= dom_id(event, :title) %>">
  <div class="room-events__item-main">
    <h3 id="<%= dom_id(event, :title) %>" class="room-events__item-title">
      <%= link_to event.title, room_event_path(room, event) %>
    </h3>
    <p class="room-events__item-meta">
      <%= local_datetime_tag(event.starts_at, style: :datetime) do %><%= event.starts_at.in_time_zone(event.time_zone).strftime("%B %-d, %Y at %-I:%M %p") %><% end %>
      <% if event.ends_at.present? %>
        &ndash; <%= local_datetime_tag(event.ends_at, style: :datetime) do %><%= event.ends_at.in_time_zone(event.time_zone).strftime("%B %-d, %Y at %-I:%M %p") %><% end %>
      <% end %>
      <span class="room-events__zone"><%= event_zone_label(event) %></span>
      <span aria-hidden="true">·</span> organized by <%= event.organizer.name %>
    </p>
    <% if event.venue.present? %>
      <p class="room-events__item-meta">
        Where:
        <span class="<%= event.venue.stage? ? "stage-room" : "voice-room" %>"><span class="sidebar-item__icon" aria-hidden="true"></span></span>
        <% if venue_member?(event.venue) %>
          <%= link_to event.venue.name, room_path(event.venue) %>
        <% else %>
          <%= event.venue.name %>
        <% end %>
        <% if event.venue.stage? %>
          <%= render "rooms/events/venue_live_dot", room: event.venue, target: dom_id(event, :venue_live_dot) %>
        <% end %>
      </p>
    <% end %>
  </div>

  <p class="room-events__item-counts">
    <%= pluralize(event.attendances.count { |attendance| attendance.response == "going" }, "going") %>,
    <%= pluralize(event.attendances.count { |attendance| attendance.response == "maybe" }, "maybe") %>
  </p>

  <% if event.series? && event.recurrence_rule.present? %>
    <p class="room-events__series-label">
      <%= recurrence_label(event.recurrence_rule) %>
      <% if (remaining = local_assigns[:series_counts]&.dig(event.id)) %>
        · <%= pluralize(remaining, "occurrence") %> remaining
      <% end %>
    </p>
  <% end %>
</article>
