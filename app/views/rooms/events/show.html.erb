<% @page_title = @event.title %>
<% @body_class = "sidebar work-workspace" %>

<% content_for :head do %>
  <%= turbo_exempts_page_from_cache %>
<% end %>

<% content_for :nav do %>
  <div class="room-header__identity room--current min-width">
    <span class="room-header__kind">Events in <%= room_display_name(@room) %></span>
    <h1 class="room__contents overflow-ellipsis">
      <span class="room-header__name overflow-ellipsis"><%= @event.title %></span>
    </h1>
  </div>

  <div class="room-header__actions">
    <%= link_to room_events_path(@room), class: "btn room-header__action", aria: { label: "All events" }, title: "All events" do %>
      <span class="room-header__action-label">All events</span>
    <% end %>
  </div>
<% end %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<section class="room-events" aria-labelledby="event-title">
  <% if @event.cancelled? %>
    <p class="room-events__cancelled" role="status">This event was cancelled.</p>
  <% end %>

  <header class="room-events__header">
    <div>
      <span class="room-events__eyebrow">Event · organized by <%= @event.organizer.name %></span>
      <h1 id="event-title"><%= @event.title %></h1>
      <p class="room-events__times">
        <%= local_datetime_tag(@event.starts_at, style: :datetime) do %><%= @event.starts_at.in_time_zone(@event.time_zone).strftime("%B %-d, %Y at %-I:%M %p") %><% end %>
        <% if @event.ends_at.present? %>
          &ndash; <%= local_datetime_tag(@event.ends_at, style: :datetime) do %><%= @event.ends_at.in_time_zone(@event.time_zone).strftime("%B %-d, %Y at %-I:%M %p") %><% end %>
        <% end %>
        <span class="room-events__zone"><%= event_zone_label(@event) %></span>
      </p>
      <% if @event.venue.present? %>
        <p class="room-events__times">
          Where:
          <span class="<%= @event.venue.stage? ? "stage-room" : "voice-room" %>"><span class="sidebar-item__icon" aria-hidden="true"></span></span>
          <% if @event.venue.memberships.exists?(user_id: Current.user.id) %>
            <%= link_to @event.venue.name, room_path(@event.venue) %>
            <%= link_to "Join", room_path(@event.venue), class: "btn btn--primary" %>
          <% else %>
            <%= @event.venue.name %>
          <% end %>
        </p>
      <% end %>
    </div>

    <% if @event.manageable_by?(Current.user) %>
      <nav class="room-events__actions" aria-label="Event management">
        <%= link_to "Edit", edit_room_event_path(@room, @event), class: "btn" %>
        <% if @event.series? %>
          <%= form_with url: cancel_room_event_path(@room, @event), method: :patch, data: { turbo_confirm: "Cancel this event? Attendees will be notified." } do %>
            <label>
              <%= radio_button_tag :cancel_scope, "this_event", true %>
              This event
            </label>
            <label>
              <%= radio_button_tag :cancel_scope, "this_and_following", false %>
              This and following
            </label>
            <%= submit_tag "Cancel event", class: "btn btn--negative" %>
          <% end %>
        <% else %>
          <%= button_to "Cancel event", cancel_room_event_path(@room, @event), method: :patch, class: "btn btn--negative", form: { data: { turbo_confirm: "Cancel this event? Attendees will be notified." } } %>
        <% end %>
      </nav>
    <% end %>
  </header>

  <% if @event.series? && @event.recurrence_rule.present? && @event.recurrence_until.present? %>
    <p class="room-events__series" role="note">
      Part of a series: repeats <%= recurrence_phrase(@event.recurrence_rule) %> until <%= recurrence_until_text(@event.recurrence_until) %>.
      <% if (previous_event = @event.previous_occurrence) %>
        <%= link_to "Previous occurrence", room_event_path(@room, previous_event) %>
      <% end %>
      <% if (next_event = @event.next_occurrence) %>
        <%= link_to "Next occurrence", room_event_path(@room, next_event) %>
      <% end %>
    </p>
  <% end %>

  <% if @event.description.present? %>
    <div class="room-events__description">
      <%= simple_format(@event.description) %>
    </div>
  <% end %>

  <% if @event.calendar_entries.exists?(user_id: Current.user.id) %>
    <p class="room-events__calendar-note" role="status">Added to your Google Calendar</p>
  <% end %>

  <section class="room-events__response" aria-labelledby="event-response-title">
    <h2 id="event-response-title" class="room-events__heading">Your response</h2>
    <% if @event.respondable_by?(Current.user) %>
      <p>
        Currently:
        <strong><%= @current_response ? @current_response.humanize : "No response yet" %></strong>
      </p>
      <%= form_with url: room_event_attendance_path(@room, @event), method: :patch, class: "room-events__responses" do %>
        <% if @event.series_head? %>
          <p class="room-events__hint">Responding here applies your response to every future occurrence in this series.</p>
        <% elsif @event.series? && @event.next_occurrence %>
          <label>
            <%= check_box_tag :apply_to_future, "1", false %>
            Apply to all future occurrences
          </label>
        <% end %>
        <%= button_tag "Going", name: "response", value: "going", class: "btn" %>
        <%= button_tag "Maybe", name: "response", value: "maybe", class: "btn" %>
        <%= button_tag "Declined", name: "response", value: "declined", class: "btn btn--plain" %>
      <% end %>
    <% elsif @event.cancelled? %>
      <p>Responses are closed because this event was cancelled.</p>
    <% end %>
  </section>

  <section class="room-events__attendees" aria-labelledby="event-attendees-title">
    <h2 id="event-attendees-title" class="room-events__heading">
      Attendees
      <span class="room-events__counts">
        <%= pluralize(@attendances.count { |attendance| attendance.response == "going" }, "going") %>,
        <%= pluralize(@attendances.count { |attendance| attendance.response == "maybe" }, "maybe") %>,
        <%= pluralize(@attendances.count { |attendance| attendance.response == "declined" }, "declined") %>
      </span>
    </h2>
    <% if @attendances.empty? %>
      <p class="room-events__empty">No responses yet.</p>
    <% else %>
      <ul class="room-events__attendee-list">
        <% @attendances.each do |attendance| %>
          <li>
            <%= attendance.user.name %>
            <span class="room-events__attendee-response">· <%= attendance.response.humanize %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</section>
