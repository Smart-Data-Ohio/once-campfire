<% @page_title = room_display_name(@room) %>
<% @body_class = "sidebar room-workspace" %>
<% content_for :head do %>
  <%= turbo_exempts_page_from_preview %>
  <meta name="current-room-id" content="<%= @room.id %>">
<% end %>

<%= render "rooms/boards/nav", room: @room %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>
<% content_for :member_panel do %>
  <%= render "rooms/show/member_panel", room: @room %>
<% end %>

<% board_view = params[:view].to_s == "board" ? "board" : "list" %>
<% status_filter = params[:status].to_s.in?(%w[ open done all ]) ? params[:status].to_s : "open" %>
<% owner_filter = params[:owner].to_s.presence || "anyone" %>
<% tag_filter = params[:tag].to_s.strip %>
<% effective_status = board_view == "board" ? "all" : status_filter %>
<% page_number = [ [ params[:page].to_s.to_i, 1 ].max, ChannelThread::BOARD_POSTS_MAX_PAGE ].min %>
<% page_size = page_number * ChannelThread::BOARD_POSTS_PER_PAGE %>
<% posts_plus_probe = ChannelThread.board_posts_for(@room, status: effective_status, owner: owner_filter, tag: tag_filter, viewer: Current.user, page: page_number).to_a %>
<% has_more_posts = posts_plus_probe.size > page_size %>
<% posts = posts_plus_probe.first(page_size) %>
<% tag_counts = ChannelThread.board_tag_counts(@room) %>
<% filter_params = { status: status_filter, owner: owner_filter, tag: tag_filter.presence }.compact %>
<%# One grouped count per page for replies, links, and owner availability, %>
<%# shared by every row so the list costs the same queries for 5 or 50 posts. %>
<% reply_counts = ChannelThread.board_reply_counts(posts) %>
<% link_counts = ChannelThread.board_link_counts(posts) %>
<% owner_active_map = ChannelThread.board_owner_active_map(@room, posts) %>
<% row_locals = { reply_counts:, link_counts:, owner_active_map: } %>
<% more_params = (board_view == "board" ? filter_params.except(:status) : filter_params).merge(view: board_view, page: page_number + 1) %>
<% list_filter_values = { status: board_view == "board" ? "all" : status_filter, owner: owner_filter, tag: tag_filter, current_user_id: Current.user.id } %>

<main class="board" aria-labelledby="board-title">
  <header class="board__header">
    <div>
      <span class="board__eyebrow">Board</span>
      <h1 id="board-title"><%= room_display_name(@room) %></h1>
      <p>Work threads with a status, an owner, tags, and a pinned result. Open a post to discuss it and record its outcome.</p>
    </div>

    <nav class="board__views" aria-label="Board rendering">
      <%= link_to "List", room_path(@room, view: "list", **filter_params), class: [ "btn", "board__view", "active": board_view == "list" ] %>
      <%= link_to "Board", room_path(@room, view: "board", **filter_params.except(:status)), class: [ "btn", "board__view", "active": board_view == "board" ] %>
    </nav>
  </header>

  <%= form_with url: room_path(@room), method: :get, class: "board__filters" do |form| %>
    <%= form.hidden_field :view, value: board_view %>
    <% if board_view == "list" %>
      <label class="board__filter">
        <span>Status</span>
        <%= form.select :status, options_for_select([ [ "Open", "open" ], [ "Done", "done" ], [ "All", "all" ] ], status_filter) %>
      </label>
    <% end %>
    <label class="board__filter">
      <span>Owner</span>
      <%= form.select :owner, options_for_select(
            [ [ "Anyone", "anyone" ], [ "Me", "me" ], [ "Agents", "agents" ] ] +
            @room.users.active.ordered.map { |user| [ user.bot? ? "#{user.name} (agent)" : user.name, user.id.to_s ] },
            owner_filter) %>
    </label>
    <label class="board__filter">
      <span>Tag</span>
      <%= form.select :tag, options_for_select([ [ "Any tag", "" ] ] + tag_counts.map { |name, count| [ "#{name} (#{count})", name ] }, tag_filter) %>
    </label>
    <%= form.submit "Filter", class: "btn" %>
    <% if status_filter != "open" || owner_filter != "anyone" || tag_filter.present? %>
      <%= link_to "Clear", room_path(@room, view: board_view), class: "btn board__clear" %>
    <% end %>
  <% end %>

  <% if posts.empty? %>
    <p class="board__empty">
      <% if @room.channel_threads.any? %>
        No posts match these filters.
      <% else %>
        No posts yet. <%= link_to "Start the first one", new_room_thread_path(@room) %>.
      <% end %>
    </p>
  <% elsif board_view == "board" %>
    <div class="board__columns" data-controller="board-list"
         data-board-list-status-value="<%= list_filter_values[:status] %>"
         data-board-list-owner-value="<%= list_filter_values[:owner] %>"
         data-board-list-tag-value="<%= list_filter_values[:tag] %>"
         data-board-list-current-user-id-value="<%= list_filter_values[:current_user_id] %>">
      <% ChannelThread::WORK_STATUSES.each do |status| %>
        <% column_posts = posts.select { |post| post.work_status == status } %>
        <section class="board__column" aria-label="<%= ChannelThread::WORK_STATUS_LABELS.fetch(status) %>">
          <h2 class="board__column-title">
            <%= ChannelThread::WORK_STATUS_LABELS.fetch(status) %>
            <span class="board__column-count"><%= column_posts.count %></span>
          </h2>
          <div id="board_column_<%= status %>" class="board__column-list" role="list">
            <%= render partial: "rooms/boards/row", collection: column_posts, as: :thread,
                  locals: row_locals.merge(dom_suffix: :board_column_row) %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <div id="board_posts" class="board__list" role="list" data-controller="board-list"
         data-board-list-status-value="<%= list_filter_values[:status] %>"
         data-board-list-owner-value="<%= list_filter_values[:owner] %>"
         data-board-list-tag-value="<%= list_filter_values[:tag] %>"
         data-board-list-current-user-id-value="<%= list_filter_values[:current_user_id] %>">
      <%= render partial: "rooms/boards/row", collection: posts, as: :thread, locals: row_locals %>
    </div>
  <% end %>

  <% if has_more_posts %>
    <p class="board__more"><%= link_to "Load more", room_path(@room, **more_params), class: "btn" %></p>
  <% end %>

  <%= turbo_stream_from @room, :messages, channel: "RoomMessagesChannel" %>
</main>
