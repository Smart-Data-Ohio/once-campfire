<%= button_to rooms_directs_path(user_ids: [ user.id ]), class: "sidebar-item direct direct--placeholder" do %>
  <span class="avatar">
    <%= image_tag fresh_user_avatar_path(user), aria: { hidden: "true" } %>
  </span>

  <span class="direct__author min-width">
    <span class="overflow-ellipsis">
      <span class="for-screen-reader">Start a ping with</span>
      <%= user.name.split(' ')[0] %>
    </span>
  </span>
<% end %>
