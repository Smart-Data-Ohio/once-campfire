<%= sidebar_turbo_frame_tag do %>
  <div class="sidebar__container"
      data-controller="badge-dot<%= " huddle-presence" if Huddle.configured? %>"
      data-badge-dot-unread-class="unread"
      data-huddle-presence-url-value="<%= huddle_presence_users_path %>"
      data-action="rooms-list:unread@window->badge-dot#update rooms-list:read@window->badge-dot#update turbo:submit-start->turbo-frame#unpermanize">
    <header class="workspace-identity">
      <div class="workspace-identity__mark" aria-hidden="true">
        <% if Current.account.logo.attached? %>
          <%= image_tag fresh_account_logo_path, alt: "", size: 36 %>
        <% else %>
          <span><%= Current.account.name.first&.upcase %></span>
        <% end %>
      </div>

      <div class="workspace-identity__text min-width">
        <strong class="overflow-ellipsis"><%= Current.account.name %></strong>
        <span>Smartfire workspace</span>
      </div>
    </header>

    <div class="sidebar__scroll overflow-y overflow-hide-scrollbar">
      <nav class="sidebar-list workspace-destinations" aria-label="Your workspace">
        <%= link_to activity_items_path, class: "sidebar-item btn", data: {
              workspace_destination: activity_items_path,
              controller: "activity-indicator",
              activity_indicator_url_value: unread_count_activity_items_path(format: :json)
            } do %>
          <%= image_tag "notification-bell-everything.svg", size: 20, aria: { hidden: "true" }, class: "colorize--black" %>
          <span class="sidebar-item__label">Activity inbox</span>
          <span class="workspace-activity-count" data-activity-indicator-target="count" hidden></span>
        <% end %>
        <%= link_to work_threads_path, class: "sidebar-item btn", data: { workspace_destination: work_threads_path } do %>
          <%= image_tag "check.svg", size: 20, aria: { hidden: "true" }, class: "colorize--black" %>
          <span class="sidebar-item__label">Work threads</span>
        <% end %>
        <%= link_to agents_path, class: "sidebar-item btn", data: { workspace_destination: agents_path } do %>
          <%= image_tag "bot.svg", size: 20, aria: { hidden: "true" }, class: "colorize--black" %>
          <span class="sidebar-item__label">Agents</span>
        <% end %>
      </nav>

      <section class="sidebar-section sidebar-section--channels rooms" aria-labelledby="channels-heading">
        <header class="sidebar-section__header">
          <h2 id="channels-heading">Channels</h2>
          <% if Current.user.administrator? || !Current.account.settings.restrict_room_creation_to_administrators? %>
            <%= link_to new_rooms_open_path, class: "btn sidebar-section__add", aria: { label: "New channel" }, title: "New channel" do %>
              <%= image_tag "add.svg", size: 16, aria: { hidden: "true" }, style: "view-transition-name: new-room" %>
            <% end %>
          <% end %>
        </header>

        <div id="shared_rooms" class="sidebar-list" data-controller="sorted-list">
          <% @other_memberships.each do |membership| %>
            <% unless membership.room.stage? || membership.room.board? %>
              <%= render "users/sidebars/rooms/shared", room: membership.room, unread: membership.unread? %>
            <% end %>
          <% end %>
        </div>
      </section>

      <section class="sidebar-section sidebar-section--boards rooms" aria-labelledby="boards-heading">
        <header class="sidebar-section__header">
          <h2 id="boards-heading">Boards</h2>
          <% if Current.user.administrator? || !Current.account.settings.restrict_room_creation_to_administrators? %>
            <%= link_to new_rooms_board_path, class: "btn sidebar-section__add", aria: { label: "New board" }, title: "New board" do %>
              <%= image_tag "add.svg", size: 16, aria: { hidden: "true" } %>
            <% end %>
          <% end %>
        </header>

        <div id="board_rooms" class="sidebar-list" data-controller="sorted-list">
          <% @other_memberships.each do |membership| %>
            <% if membership.room.board? %>
              <%= render "users/sidebars/rooms/board", room: membership.room, unread: membership.unread? %>
            <% end %>
          <% end %>
        </div>
      </section>

      <section class="sidebar-section sidebar-section--voice rooms" aria-labelledby="voice-heading">
        <header class="sidebar-section__header">
          <h2 id="voice-heading">Voice</h2>
          <% if Current.user.administrator? || !Current.account.settings.restrict_room_creation_to_administrators? %>
            <%= link_to new_rooms_stage_path, class: "btn sidebar-section__add", aria: { label: "New stage channel" }, title: "New stage channel" do %>
              <%= image_tag "add.svg", size: 16, aria: { hidden: "true" } %>
            <% end %>
            <%= link_to new_rooms_voice_path, class: "btn sidebar-section__add", aria: { label: "New voice channel" }, title: "New voice channel" do %>
              <%= image_tag "add.svg", size: 16, aria: { hidden: "true" } %>
            <% end %>
          <% end %>
        </header>

        <div id="voice_rooms" class="sidebar-list" data-controller="sorted-list">
          <% @voice_memberships.each do |membership| %>
            <%= render "users/sidebars/rooms/voice", room: membership.room, unread: membership.unread? %>
          <% end %>
          <% @other_memberships.each do |membership| %>
            <% if membership.room.stage? %>
              <%= render "users/sidebars/rooms/stage", room: membership.room, unread: membership.unread? %>
            <% end %>
          <% end %>
        </div>
      </section>

      <turbo-frame id="direct_rooms_control" target="_top">
        <section class="sidebar-section" aria-labelledby="direct-messages-heading">
          <header class="sidebar-section__header">
            <h2 id="direct-messages-heading">Direct messages</h2>
            <%= link_to new_rooms_direct_path, class: "btn sidebar-section__add", data: { turbo_frame: "_self" }, aria: { label: "New direct message" }, title: "New direct message" do %>
              <%= image_tag "add.svg", size: 16, aria: { hidden: "true" } %>
            <% end %>
          </header>

          <div id="direct_rooms" class="sidebar-list" data-controller="sorted-list" data-action="rooms-list:unread@window->sorted-list#updateItem">
            <%# The in-call participant ids join the collection key so a cached row never serves stale presence. %>
            <%= render partial: "users/sidebars/rooms/direct", collection: @direct_memberships, as: :membership,
                  cached: ->(membership) { [ membership, huddle_participants_by_room_id[membership.room_id]&.map(&:id) ] } %>
          </div>

          <div class="sidebar-list sidebar-list--people" aria-label="Start a direct message">
            <%= render partial: "users/sidebars/rooms/direct_placeholder", collection: @direct_placeholder_users, as: :user %>
          </div>
        </section>
      </turbo-frame>
    </div>
  </div>

  <div class="sidebar__tools">
    <%= link_to user_profile_path, class: "workspace-user min-width" do %>
      <span class="avatar workspace-user__avatar">
        <%= image_tag fresh_user_avatar_path(Current.user), size: 36, aria: { hidden: "true" }, style: "view-transition-name: avatar-#{Current.user.id}" %>
      </span>
      <span class="workspace-user__identity min-width">
        <strong class="overflow-ellipsis"><%= Current.user.name %></strong>
        <span>Profile</span>
      </span>
    <% end %>

    <%= link_to edit_account_path, class: "btn sidebar__tool", aria: { label: "Account settings" }, title: "Account settings" do %>
      <%= image_tag "settings.svg", size: 20, aria: { hidden: "true" }, style: "view-transition-name: account-settings" %>
    <% end %>
  </div>
<% end %>
