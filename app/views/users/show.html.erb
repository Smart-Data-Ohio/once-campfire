<% @page_title = @user.name %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back %>
  </div>

  <div class="flex align-center gap flex-item-justify-end">
    <% if Current.user == @user %>
      <%= link_to user_profile_path, class: "btn" do %>
        <%= image_tag "pencil.svg", aria: { hidden: "true" } %>
        <span class="for-screen-reader">Edit my profile</span>
      <% end %>
    <% end %>
  </div>
<% end %>

<section class="panel txt-align-center">
  <div class="flex flex-column gap <%= "banned" if @user.banned? %>">
    <div class="avatar txt-xx-large center" style="background: white">
      <%= image_tag fresh_user_avatar_path(@user), alt: "Profile avatar", class: "avatar" %>
    </div>

    <% if @user.bot? %>
      <div class="flex flex-column gap" style="--row-gap: calc(var(--block-space) / 3)">
        <h1 class="txt-x-large txt-tight-lines margin-none"><%= @user.name %></h1>

        <% if (agent = @user.agent) %>
          <%= turbo_stream_from AgentsChannel::STREAM_NAME, channel: "AgentsChannel" %>

          <div class="txt-small"><%= agent.kind_description %></div>

          <% if agent.provider.present? || agent.runtime.present? %>
            <div class="txt-small"><%= [ agent.provider, agent.runtime ].compact_blank.join(" · ") %></div>
          <% end %>

          <% if agent.description.present? %>
            <div><%= agent.description %></div>
          <% end %>

          <div class="txt-small">
            <%= render "agents/status_badge", agent: agent %>
          </div>

          <div class="txt-small">
            <%= agent.last_seen_at ? "last seen #{time_ago_in_words(agent.last_seen_at)} ago" : "never" %>
          </div>

          <% agent_rooms = agent.user.rooms.ordered %>
          <% if agent_rooms.exists? %>
            <% shared_rooms = agent_rooms.where(id: Current.user.rooms.select(:id)).to_a %>
            <% hidden_room_count = agent_rooms.count - shared_rooms.size %>
            <div class="txt-small">
              Rooms: <%= safe_join(shared_rooms.map { |room| link_to(room_display_name(room), room_path(room)) }, ", ") %><% if hidden_room_count.positive? %><%= ", " if shared_rooms.any? %>and <%= hidden_room_count %> more<% end %>
            </div>
          <% end %>

          <div class="txt-small">Grants: <%= agent.grants_summary %></div>

          <% if Current.user.administrator? || agent.owner == Current.user %>
            <div class="txt-small">Last 24 hours: <%= agent.activity_summary %></div>
          <% end %>
        <% end %>
      </div>

      <div class="pad-double--inline push--inline push--block-start">
        <% if @user.active? %>
          <%= button_to_direct_room_with @user%>
          <% if Current.user.administrator? || @user.agent&.owner == Current.user %>
            <div class="margin-block-start">
              <%= link_to account_bot_grants_path(@user), class: "btn full-width" do %>
                <%= image_tag "key.svg", aria: { hidden: "true" }, size: 20 %>
                Manage capability grants
              <% end %>
            </div>
            <% if @user.agent %>
              <div class="margin-block-start">
                <%= link_to agent_events_path(@user.agent), class: "btn full-width" do %>
                  <%= image_tag "messages-outlined.svg", aria: { hidden: "true" }, size: 20 %>
                  View activity ledger
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div><%= @user.name %> is no longer on this account</div>
        <% end %>
      </div>
    <% else %>
      <% unless @user.deactivated? %>
        <div class="flex flex-column gap" style="--row-gap: calc(var(--block-space) / 3)">
          <h1 class="txt-x-large txt-tight-lines margin-none"><%= @user.name %></h1>
          <% if Current.user.can_administer? %>
            <div><%= mail_to @user.email_address %></div>
          <% end %>
          <div><%= @user.bio %></div>
        </div>

        <% if @user.active? %>
          <div class="pad-inline-double margin-inline margin-block-start">
            <%= button_to rooms_directs_path(user_ids: [ @user.id ]), class: "btn btn--reversed full-width txt-large" do %>
              <%= image_tag "messages.svg", aria: { hidden: "true", label: "Ping #{@user.name}" } %>
            <% end %>
          </div>

          <% if Current.user.can_administer? %>
            <hr class="margin-block-start borderless">

            <%= render "users/profiles/transfer", user: @user %>
          <% end %>
        <% end %>

        <% if Current.user.can_administer? && Current.user != @user %>
          <div class="margin-block-start">
            <%= render "users/ban_button", user: @user %>
          </div>
        <% end %>
      <% else %>
        <div>
          <h1 class="txt-x-large margin-none"><%= @user.name %></h1>
          <div><%= @user.name %> is no longer on this account</div>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
