<!DOCTYPE html>
<html>
  <head>
    <%= page_title_tag %>

    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no, interactive-widget=resizes-content">
    <meta name="view-transition" content="same-origin">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#15171c" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= current_user_meta_tags %>
    <%= script_aware_action_cable_meta_tag %>

    <%= tag.meta name: "vapid-public-key", content: Rails.configuration.x.vapid.public_key %>
    <%= tag.meta name: "turbo-prefetch", content: "true" %>
    <%= tag.meta name: "google-drive-previews", content: "enabled" if Current.user&.google_account&.drive? %>
    <%= tag.meta name: "brand-icon-names", content: Icons.client_icon_names.join(",") %>

    <%= tag.link rel: "manifest", href: webmanifest_path(format: :json) %>
    <%= tag.link rel: "icon", href: fresh_account_logo_path, type: "image/png" %>
    <%= tag.link rel: "apple-touch-icon", href: fresh_account_logo_path %>

    <%= stylesheet_link_tag :all, "data-turbo-track": "reload" %>
    <%= custom_styles_tag %>

    <%= javascript_importmap_tags %>

    <%= yield :head %>
  </head>

  <body class="<%= body_classes %>"
        data-controller="local-time lightbox workspace-navigation member-panel thread-panel"
        data-action="keydown.esc@window->workspace-navigation#close keydown.esc@window->member-panel#close keydown.esc@window->thread-panel#close keydown@window->member-panel#trapFocus keydown@window->thread-panel#trapFocus member-panel:opening@window->workspace-navigation#close member-panel:opening@window->thread-panel#close workspace-navigation:opening@window->member-panel#close workspace-navigation:opening@window->thread-panel#close thread-messages:changed->thread-panel#messagesChanged thread-panel:opening@window->member-panel#close thread-panel:opening@window->workspace-navigation#close workspace-presence:connected@window->member-panel#refreshPresence turbo:before-cache@document->member-panel#prepareForCache turbo:before-cache@document->thread-panel#prepareForCache turbo:frame-load@document->workspace-navigation#syncCurrentRoom turbo:load@document->workspace-navigation#syncCurrentRoom turbo:load@document->member-panel#roomChanged rooms-list:unread@window->workspace-navigation#updateUnreadStatus rooms-list:read@window->workspace-navigation#updateUnreadStatus">
    <a href="#main-content" class="skip-navigation btn">Skip to main content</a>

    <nav id="nav">
      <button type="button"
              class="btn workspace-navigation__open"
              aria-controls="sidebar"
              aria-expanded="false"
              aria-label="Open workspace navigation"
              data-workspace-navigation-target="opener"
              data-action="workspace-navigation#open">
        <%= image_tag "menu.svg", size: 20, aria: { hidden: "true" } %>
      </button>

      <%= yield :nav %>
    </nav>

    <% if notice = flash[:notice] || flash[:alert] %>
      <div class="flash" data-controller="element-removal" data-action="animationend->element-removal#remove">
        <div class="flash__inner shadow" style="<%= "--flash-background: var(--color-negative)" if flash[:alert] %>">
          <% if flash[:alert] %>
            <%= image_tag "alert.svg", aria: { hidden: true }, size: 24, class: "colorize--white" %></span>
          <% else %>
            <%= image_tag "check.svg", aria: { hidden: true }, size: 24, class: "colorize--white" %></span>
          <% end %>
        </div>
        <span class="for-screen-reader" role="alert" aria-atomic="true"><%= notice %></span>
      </div>
    <% end %>

    <main id="main-content">
      <%= yield %>

      <footer id="footer">
        <%= yield :footer %>
      </footer>
    </main>

    <%= yield :member_panel %>

    <%= yield :thread_panel %>

    <aside id="sidebar"
           role="navigation"
           aria-label="Workspace navigation"
           data-workspace-navigation-target="sidebar"
           data-action="click->workspace-navigation#navigate keydown->workspace-navigation#trapFocus">
      <button type="button"
              class="workspace-navigation__backdrop"
              aria-hidden="true"
              tabindex="-1"
              data-workspace-navigation-target="backdrop"
              data-action="workspace-navigation#close"
              hidden></button>
      <%= yield :sidebar %>
    </aside>

    <% if Current.user %>
      <%# The rooms subscriptions live here, outside the reloading sidebar frame: those streams also drive %>
      <%# main-page targets, and a sidebar reload would otherwise drop broadcasts in the resubscribe gap. %>
      <%= turbo_stream_from :rooms %>
      <%= turbo_stream_from Current.user, :rooms %>
      <div id="workspace_presence" data-controller="workspace-presence" data-turbo-permanent hidden></div>
    <% end %>

    <%= render "layouts/huddle" if Current.user && Huddle.configured? %>

    <%= render "layouts/huddle_invitation" if Current.user && Huddle.configured? %>

    <%= render "layouts/lightbox" %>

    <a href="https://once.com" id="app-logo" target="_blank" aria-label="Once software from 37signals home page">
      <%= image_tag "campfire-icon.png", alt: "Campfire logo", width: 256, height: 216 %>
    </a>
  </body>
</html>
