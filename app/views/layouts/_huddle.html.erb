<section id="channel-huddle"
         class="huddle shadow"
         data-turbo-permanent
         data-controller="huddle"
         data-huddle-current-user-id-value="<%= Current.user.id %>"
         data-huddle-noise-worklet-url-value="<%= asset_path("noise-suppressor-worklet.js") %>"
         data-huddle-noise-wasm-url-value="<%= asset_path("rnnoise.wasm") %>"
         data-huddle-noise-simd-wasm-url-value="<%= asset_path("rnnoise-simd.wasm") %>"
         data-state="idle"
         aria-labelledby="huddle-room-name"
         hidden>
  <header class="huddle__header">
    <div class="min-width">
      <h2 id="huddle-room-name" class="huddle__title overflow-ellipsis" data-huddle-target="roomName">Huddle</h2>
      <p class="huddle__status" data-huddle-target="status" role="status" aria-live="polite">Not in a huddle</p>
    </div>

    <div class="huddle__header-actions">
      <button type="button"
              class="btn btn--plain huddle__connection"
              data-huddle-target="connection"
              data-action="huddle#toggleConnectionDetails"
              data-quality="fair"
              aria-expanded="false"
              aria-label="Connection quality: fair. Show details."
              hidden>
        <span class="huddle__connection-bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>

      <button type="button" class="btn btn--plain huddle__leave" data-action="huddle#leave">
        <span data-huddle-target="leaveLabel">Leave</span>
      </button>
    </div>
  </header>

  <dl class="huddle__connection-details" data-huddle-target="connectionDetails" hidden>
    <div><dt>Round-trip time</dt><dd data-huddle-target="statRtt">–</dd></div>
    <div><dt>Packet loss</dt><dd data-huddle-target="statLoss">–</dd></div>
    <div><dt>Jitter</dt><dd data-huddle-target="statJitter">–</dd></div>
    <div><dt>Received</dt><dd data-huddle-target="statRx">–</dd></div>
    <div><dt>Sent</dt><dd data-huddle-target="statSent">–</dd></div>
    <div><dt>Transport</dt><dd data-huddle-target="statTransport">–</dd></div>
  </dl>

  <p class="huddle__notice" data-huddle-target="notice" role="alert" hidden></p>

  <p class="huddle__listening" data-huddle-target="listeningNote" hidden>You are listening</p>

  <div class="huddle__sharing" data-huddle-target="sharing" hidden>
    <span class="huddle__sharing-name overflow-ellipsis" data-huddle-target="sharingName">Someone is sharing a screen</span>
    <button type="button"
            class="btn btn--reversed huddle__sharing-view"
            data-huddle-target="sharingExpand"
            data-action="huddle#viewSharedScreen">View</button>
  </div>

  <button type="button" class="btn huddle__resume-audio" data-huddle-target="resumeAudio" data-action="huddle#resumeAudio" hidden>
    Play huddle audio
  </button>

  <label class="huddle__stream-quality" data-huddle-target="streamQualityRow" hidden>
    <span>Stream quality</span>
    <select class="input" data-huddle-target="streamQuality" data-action="huddle#streamQualityChanged">
      <option value="auto">Auto</option>
      <option value="low">Low</option>
      <option value="high">High</option>
    </select>
  </label>

  <div class="huddle__screens" data-huddle-target="screens" aria-label="Shared screens" hidden></div>

  <div class="huddle__cameras" data-huddle-target="cameras" aria-label="Cameras" hidden></div>

  <div class="huddle__people" data-huddle-target="people" hidden>
    <div class="huddle__people-heading">
      <h3>People</h3>
      <span class="txt-small txt-subtle" data-huddle-target="participantCount">0 participants</span>
    </div>
    <ul class="huddle__participants" data-huddle-target="participantList"></ul>
  </div>

  <div class="huddle__controls" data-huddle-target="activeControls" hidden>
    <div class="huddle__mute-group">
      <button type="button" class="btn huddle__mute" data-huddle-target="mute" data-action="huddle#toggleMute" aria-pressed="false">
        <span data-huddle-target="muteLabel">Mute</span>
      </button>
      <span class="huddle__meter"
            data-huddle-target="meter"
            role="meter"
            aria-label="Microphone level"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            hidden><span class="huddle__meter-fill" data-huddle-target="meterFill"></span></span>
    </div>
    <button type="button" class="btn" data-huddle-target="share" data-action="huddle#toggleScreenShare" aria-pressed="false">
      <span data-huddle-target="shareLabel">Share screen</span>
    </button>
    <button type="button" class="btn" data-huddle-target="camera" data-action="huddle#toggleCamera" aria-pressed="false">
      <span data-huddle-target="cameraLabel">Camera off</span>
    </button>
  </div>

  <div class="huddle__settings" data-huddle-target="settings" hidden>
    <div class="huddle__devices" data-huddle-target="devicesBlock" hidden>
      <h3 class="huddle__devices-heading">Check your devices</h3>

      <label class="huddle__device">
        <span>Microphone</span>
        <select class="input" data-huddle-target="microphoneSelect" data-action="huddle#microphoneChanged"></select>
      </label>

      <label class="huddle__device" data-huddle-target="speakerRow">
        <span>Speaker</span>
        <select class="input" data-huddle-target="speakerSelect" data-action="huddle#speakerChanged"></select>
      </label>

      <label class="huddle__device">
        <span>Camera</span>
        <select class="input" data-huddle-target="cameraSelect" data-action="huddle#cameraChanged"></select>
      </label>

      <div class="huddle__preview-wrap" data-huddle-target="previewWrap" hidden>
        <video class="huddle__preview" data-huddle-target="preview" autoplay playsinline muted></video>
      </div>

      <span class="huddle__meter huddle__meter--prejoin"
            data-huddle-target="prejoinMeter"
            role="meter"
            aria-label="Microphone level"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            hidden><span class="huddle__meter-fill" data-huddle-target="prejoinMeterFill"></span></span>

      <p class="huddle__check-error" data-huddle-target="checkError" role="alert" hidden></p>

      <div class="huddle__devices-actions">
        <button type="button" class="btn btn--reversed" data-huddle-target="checkJoin" data-action="huddle#confirmPrejoinJoin" disabled>Join</button>
        <button type="button" class="btn btn--plain" data-huddle-target="checkRetry" data-action="huddle#retryPrejoin" hidden>Try again</button>
        <button type="button" class="btn btn--plain" data-huddle-target="devicesDone" data-action="huddle#closeDevices" hidden>Done</button>
      </div>
    </div>

    <div class="huddle__settings-row" data-huddle-target="settingsRow" hidden>
      <button type="button"
              class="btn btn--plain huddle__noise"
              data-huddle-target="noise"
              data-action="huddle#toggleNoiseSuppression"
              aria-pressed="true">
        <span data-huddle-target="noiseLabel">Noise suppression on</span>
      </button>
      <button type="button"
              class="btn btn--plain huddle__check-devices"
              data-huddle-target="checkDevices"
              data-action="huddle#toggleDevices"
              aria-expanded="false">
        Check devices
      </button>
    </div>
  </div>

  <button type="button" class="btn btn--reversed huddle__retry" data-huddle-target="retry" data-action="huddle#retry" hidden>
    Try again
  </button>

  <div id="huddle_role_events" data-huddle-target="roleEvents" hidden></div>
</section>
